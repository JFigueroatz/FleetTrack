<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FleetTrack.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ingresar">

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="FleetTrack" FontSize="28" HorizontalOptions="Center" />

        <Entry x:Name="EmailEntry" Placeholder="Correo" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Contrasena" IsPassword="True" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        <Button x:Name="LoginButton" Text="Ingresar" Clicked="OnLoginClicked" />
        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />
    </VerticalStackLayout>

</ContentPage>
