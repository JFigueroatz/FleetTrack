<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FleetTrack.Mobile.Pages.RoutePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi ruta">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label x:Name="DriverLabel" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" />

            <CollectionView x:Name="DeliveriesView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnDefinitions="*,Auto,Auto,Auto">
                            <Label Text="{Binding Label}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Iniciar" Clicked="OnStartClicked" CommandParameter="{Binding Id}" />
                            <Button Grid.Column="2" Text="Evidencia" Clicked="OnEvidenceClicked" CommandParameter="{Binding Id}" />
                            <Button Grid.Column="3" Text="Finalizar" Clicked="OnCompleteClicked" CommandParameter="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="MessageLabel" TextColor="Green" />
            <Label x:Name="ErrorLabel" TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
